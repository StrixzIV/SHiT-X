# Copy to functions/.env for Firebase, or root .env.local for local overrides.
# The demo's functions/.env is committed at the user's request. Keys are read
# by the server, never placed in frontend assets.

# น้องปลั๊ก's brain: DeepSeek, OpenAI-compatible chat completions
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Her voice: Paxa Labs TTS (POST /v1/tts)
PAXA_API_KEY=
PAXA_VOICE=bualoi
