# Copy to functions/.env for demo defaults, or root .env.local for local overrides.
# The throwaway demo's functions/.env is committed at the user's request.
# npm run build embeds these provider keys for free Firebase Hosting.
# Development and npm run build:backend use server-only keys instead.

# น้องปลั๊ก's brain: DeepSeek, OpenAI-compatible chat completions
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Her voice: Paxa Labs TTS (POST /v1/tts)
PAXA_API_KEY=
PAXA_VOICE=bualoi
# PAXA_MODEL=paxa-tts-flash-v1
# PAXA_BASE_URL=https://api.paxalabs.com
